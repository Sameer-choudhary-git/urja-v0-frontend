# Copy to .env.local (git-ignored). Read on the SERVER only: the browser never sees the key.

# Where urja-api runs (no trailing slash). Local API: http://localhost:3000, EC2: http://<EC2_IP>
URJA_API_BASE_URL=http://localhost:3000

# One of the keys in the API's API_KEYS (the part after "name:"). Give the web app its own name,
# e.g. API_KEYS=...,web:<key>, so its traffic is visible separately in the API logs.
URJA_API_KEY=

# Optional: CARTO Basemaps key for the dark map tiles (free at carto.com/basemaps).
# Without it the map uses OpenStreetMap tiles with a dark filter.
# This one is public on purpose (the browser sends it with every tile request);
# restrict it to your domains in the CARTO dashboard.
NEXT_PUBLIC_CARTO_BASEMAPS_KEY=
